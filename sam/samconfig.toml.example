version = 0.1

[default]
[default.global.parameters]
stack_name = "virtual-me-v2"

[default.build.parameters]
cached = true
parallel = true
use_container = true

[default.deploy.parameters]
stack_name = "virtual-me-v2"
region = "eu-west-3"
confirm_changeset = true
capabilities = "CAPABILITY_IAM CAPABILITY_NAMED_IAM CAPABILITY_AUTO_EXPAND"
# Update these values before deploying:
# - Route53ZoneId: Your Route53 hosted zone ID for your domain
# - ApiCertificateArn: ACM certificate ARN in your region for API subdomain
# - CloudFrontCertificateArn: ACM certificate ARN in us-east-1 for CloudFront
parameter_overrides = [
    "Environment=prod",
    "DomainName=example.com",
    "FrontendSubdomain=chat",
    "ApiSubdomain=api",
    "LlmModel=nova-2-lite",
    "LlmTemperature=0.1",
    "Route53ZoneId=ZXXXXXXXXXXXXX",
    "ApiCertificateArn=arn:aws:acm:eu-west-3:123456789012:certificate/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx",
    "CloudFrontCertificateArn=arn:aws:acm:us-east-1:123456789012:certificate/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx",
]
s3_prefix = "virtual-me-v2"
resolve_s3 = true
disable_rollback = false
tags = "Project=\"VirtualMe\" Environment=\"prod\" ManagedBy=\"SAM\""

[default.validate.parameters]
lint = true

[default.sync.parameters]
watch = true

[default.logs.parameters]
stack_name = "virtual-me-v2"
